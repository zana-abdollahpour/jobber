{
  "name": "@jobber/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "generate-ts-proto": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto.cmd --ts_proto_out=./types ./proto/*.proto --ts_proto_opt=nestJs=true --ts_proto_opt=exportCommonSymbols=false"
  },
  "nx": {
    "targets": {
      "generate-ts-proto": {
        "cache": true,
        "inputs": [
          "{workspaceRoot}/proto/*.proto"
        ]
      }
    }
  },
  "private": true,
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nx/js": "24.0.6",
    "@protobuf-ts/protoc": "^2.11.1",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "nx": "24.0.6",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/apollo": "^14.2.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/graphql": "^14.2.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/microservices": "^12.6.0",
    "graphql": "^16.15.0",
    "ts-proto": "^2.23.8"
  }
}
