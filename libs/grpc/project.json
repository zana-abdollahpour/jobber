{
  "name": "grpc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "build": { "dependsOn": ["^build", "generate-ts-proto"] },
    "generate-ts-proto": {
      "cache": true,
      "options": {
        "cwd": "{projectRoot}/src/lib",
        "inputs": ["proto/*.proto"]
      },
      "command": "protoc --plugin=../../../../node_modules/.bin/protoc-gen-ts_proto.cmd --ts_proto_out=./types ./proto/*.proto --ts_proto_opt=nestJs=true"
    }
  }
}
