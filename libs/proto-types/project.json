{
  "name": "proto-types",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npx tsc -p libs/proto-types/tsconfig.json",
        "cwd": "."
      }
    },
    "generate": {
      "command": "npm run generate-ts-proto"
    }
  }
}
