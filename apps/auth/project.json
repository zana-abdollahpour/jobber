{
  "name": "auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/auth/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nest build",
        "cwd": "apps/auth"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nest start --watch",
        "cwd": "apps/auth"
      }
    }
  }
}
